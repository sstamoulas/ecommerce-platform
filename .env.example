# Leave unset to auto-use Postgres when DATABASE_URL is present.
# Set DATA_BACKEND=mock for offline local development.
DATA_BACKEND=

# Firestore
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Postgres
DATABASE_URL=
POSTGRES_SSL=true
POSTGRES_AUTO_BOOTSTRAP=false

# Admin auth
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Fulfillment webhooks
FULFILLMENT_WEBHOOK_SECRET=
SHIPBOB_WEBHOOK_SECRET=

# Outbound fulfillment dispatch
# Example:
# FULFILLMENT_DISPATCH_ENDPOINTS_JSON={"partner_shipbob":{"url":"https://api.shipbob.com/2026-01/order","headers":{"authorization":"Bearer replace-me","shipbob_channel_id":"replace-me"}}}
FULFILLMENT_DISPATCH_ENDPOINTS_JSON=
FULFILLMENT_DISPATCH_TIMEOUT_MS=10000
